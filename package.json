{
  "name": "dsh-cline-pass",
  "version": "0.1.1",
  "description": "Self-contained Cline Pass provider for dsh: register Cline Pass subscription models on the harness LLM seam, enumerate and validate the upstream channels behind each model, pin or exclude them with failover, and drive an account pool. No proxy process and no external cline-pass-switcher install required.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.mjs && node test/client.mjs",
    "test:client": "node test/client.mjs",
    "test:mount": "node test/mount.mjs",
    "test:live": "node test/live-efforts.mjs",
    "test:live:image": "node test/live-image.mjs",
    "test:live:reasoning": "node test/live-reasoning.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "llm-provider",
    "cline-pass",
    "cline",
    "openrouter",
    "vercel-ai-gateway"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-connection"
      ]
    },
    "compatibility": {
      "dsh": ">=0.1.2-alpha.3 <0.2.0"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-credentials": ">=0.1.2-alpha.3 <0.2.0",
    "@deepseek-ai/dsh-launch-environment": ">=0.1.2-alpha.3 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.2-alpha.3 <0.2.0",
    "@deepseek-ai/dsh-settings": ">=0.1.2-alpha.3 <0.2.0",
    "@deepseek-ai/dsh-timeout": ">=0.1.2-alpha.3 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.2-alpha.3 <0.2.0",
    "@deepseek-ai/dsh-util-values": ">=0.1.2-alpha.3 <0.2.0",
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
